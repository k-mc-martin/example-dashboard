    {
      "parameters": {
        "jsCode": "const domainName = String($json?.domainName ?? $json?.domain ?? '').toLowerCase();\nif (domainName !== 'example.invalid') throw new Error('GoDaddy did not return the expected example.invalid domain');\nreturn [{ json: { provider: 'godaddy', status: 'verified', identity: { domain: domainName }, checkedAt: new Date().toISOString() } }];"
      },
      "id": "69ab9545-911f-4c79-a9f9-77cf098c34c7",
      "name": "Validate and whitelist identity",
