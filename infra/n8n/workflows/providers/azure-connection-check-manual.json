        "jsCode": "const expectedId = '/subscriptions/00000000-0000-4000-8000-000000000001/resourcegroups/demo-signing-rg/providers/microsoft.codesigning/codesigningaccounts/demo-signing';\nconst resourceId = String($json?.id ?? '').toLowerCase();\nconst name = String($json?.name ?? '').toLowerCase();\nconst type = String($json?.type ?? '').toLowerCase();\nif (resourceId !== expectedId || name !== 'demo-signing' || type !== 'microsoft.codesigning/codesigningaccounts') throw new Error('Azure did not return the expected demo-signing code signing account');\nreturn [{ json: { provider: 'azure', status: 'verified', identity: { subscriptionId: '00000000-0000-4000-8000-000000000001', resourceGroup: 'demo-signing-rg', resourceType: 'Microsoft.CodeSigning/codeSigningAccounts', accountName: 'demo-signing' }, checkedAt: new Date().toISOString() } }];"
