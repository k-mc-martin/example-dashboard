    {
      "parameters": {
        "jsCode": "const accountId = '00000000000000000000000000000001';\nconst publicBody = $('Read public Pages project').first().json;\nconst betaBody = $('Read beta Pages project').first().json;\nconst bucketBody = $('Read downloads R2 bucket').first().json;\nconst publicProject = publicBody?.success === true ? publicBody.result : null;\nconst betaProject = betaBody?.success === true ? betaBody.result : null;\nconst bucket = bucketBody?.success === true ? bucketBody.result : null;\nif (publicProject?.name !== 'dupdash-public') throw new Error('Cloudflare did not return the expected dupdash-public Pages project');\nif (betaProject?.name !== 'dupdash-beta') throw new Error('Cloudflare did not return the expected dupdash-beta Pages project');\nif (bucket?.name !== 'dupdash-downloads') throw new Error('Cloudflare did not return the expected dupdash-downloads R2 bucket');\nreturn [{ json: { provider: 'cloudflare', status: 'verified', identity: { accountId, pagesProjects: [publicProject.name, betaProject.name], r2Bucket: bucket.name }, checkedAt: new Date().toISOString() } }];"
      },
