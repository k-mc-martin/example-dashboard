      "id": "b1ec790d-e594-4948-b044-d8f8d7aafbc4",
      "name": "Read Drive storage quota",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "DupdashGoogleDriveStorage",
          "name": "Dupdash Google Drive storage"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const observedAt = new Date().toISOString();\nconst result = $json;\nconst rawStatus = result?.statusCode ?? result?.status ?? result?.error?.statusCode ?? result?.error?.httpCode;\nconst statusCode = Number(rawStatus);\nconst errorPayload = (code) => [{ json: { provider: 'google-drive', observedAt, status: 'error', errorCode: code } }];\nif (statusCode === 401 || statusCode === 403) return errorPayload('authorization_required');\nif (!Number.isInteger(statusCode)) {\n  const errorText = String(result?.error?.message ?? result?.error ?? result?.message ?? '');\n  if (/invalid_grant|invalid_client|unauthorized_client|invalid_token|\\b401\\b|\\b403\\b/i.test(errorText)) return errorPayload('authorization_required');\n  return errorPayload('provider_unavailable');\n}\nif (statusCode === 429 || statusCode >= 500) return errorPayload('provider_unavailable');\nif (statusCode < 200 || statusCode >= 300) return errorPayload('invalid_response');\nconst quota = result?.body?.storageQuota;\nconst canonicalBytes = (value, nullable = false) => {\n  if (nullable && (value === undefined || value === null)) return null;\n  if (typeof value !== 'string' || !/^(0|[1-9]\\d*)$/.test(value)) throw new Error('invalid');\n  const number = Number(value);\n  if (!Number.isSafeInteger(number) || number < 0) throw new Error('invalid');\n  return value;\n};\ntry {\n  if (!quota || typeof quota !== 'object' || Array.isArray(quota)) throw new Error('invalid');\n  const limitBytes = canonicalBytes(quota.limit, true);\n  const usedBytes = canonicalBytes(quota.usage);\n  const driveBytes = canonicalBytes(quota.usageInDrive);\n  const trashBytes = canonicalBytes(quota.usageInDriveTrash);\n  return [{ json: { provider: 'google-drive', observedAt, status: 'ok', quota: { limitBytes, usedBytes, driveBytes, trashBytes } } }];\n} catch {\n  return errorPayload('invalid_response');\n}"
      },
