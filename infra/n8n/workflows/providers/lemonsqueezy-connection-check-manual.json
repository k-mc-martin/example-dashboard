    {
      "parameters": {
        "jsCode": "const stores = Array.isArray($json?.data) ? $json.data : [];\nconst matches = stores.filter((entry) => entry?.type === 'stores' && entry?.id === '100001' && entry?.attributes?.domain === 'store.example.invalid');\nif (matches.length !== 1) throw new Error(`Expected exactly one store 100001 at store.example.invalid; received ${matches.length}`);\nconst store = matches[0];\nreturn [{ json: { provider: 'lemonsqueezy', status: 'verified', identity: { storeId: String(store.id), domain: store.attributes.domain }, checkedAt: new Date().toISOString() } }];"
      },
      "id": "bf8e6c62-a7d5-480c-967c-b589e282ac6c",
