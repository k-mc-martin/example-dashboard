            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ (() => { const raw = $response.body?.['@odata.nextLink']; const initial = $('Build overlapped Inbox URL').first().json.startUrl; const inbox = RegExp(\"^https://mail[.]secdash[.]invalid(?::443)?/v1[.]0/me/mailFolders(?:/inbox|[(]'inbox'[)]|%28%27inbox%27%29)/messages(?:[?]|$)\", \"i\"); if (!raw) return initial; if (typeof raw !== 'string' || !inbox.test(raw)) throw Error('Microsoft Graph returned an unexpected pagination URL'); return raw; })() }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body?.['@odata.nextLink'] }}",
              "limitPagesFetched": true,
              "maxRequests": 100,
              "requestInterval": 200
            }
          },
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
