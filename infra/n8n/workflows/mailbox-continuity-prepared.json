      "parameters": {
        "jsCode": "const base='https://mail.secdash.invalid/v1.0/me/mailFolders/inbox/messages';const parts=['%24top=25','%24orderby='+encodeURIComponent('receivedDateTime asc'),'%24select='+encodeURIComponent('id,internetMessageId,from,subject,body,receivedDateTime,webLink')];if($json.watermark){const t=Date.parse($json.watermark);if(!Number.isFinite(t))throw Error('Invalid checkpoint watermark');parts.push('%24filter='+encodeURIComponent('receivedDateTime ge '+new Date(t-600000).toISOString()));}return [{json:{...$json,startUrl:base+'?'+parts.join('&')}}];"
      },
      "id": "start-url",
      "name": "Build overlapped Inbox URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.startUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "outlook.body-content-type=\"text\", IdType=\"ImmutableId\""
            },
