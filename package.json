{
  "name": "secdash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "dev:node": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:node": "next build",
    "desktop:ui": "vite build --config desktop/vite.config.mjs",
    "start": "node scripts/start-node.mjs",
    "start:node": "node scripts/start-node.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.json",
    "db:node:init": "node --experimental-strip-types scripts/init-node-db.mjs",
    "test:db:node": "node --experimental-strip-types --test tests/node-sqlite.test.mjs tests/provider-connections.test.mjs tests/infrastructure-category.test.mjs",
    "test:access": "node --experimental-strip-types --test tests/server-auth.test.mjs infra/dashboard/access.test.mjs",
    "demo:up": "docker compose -f infra/simulation/compose.yml up --build -d --wait",
    "demo:down": "docker compose -f infra/simulation/compose.yml down",
    "test:providers": "node --test tests/fictional-providers.test.mjs tests/demo-isolation.test.mjs",
    "test:providers:http": "node tests/fictional-providers-http.mjs",
    "test:accounts:http": "node --test tests/demo-accounts-http.mjs",
    "verify:accounts": "node scripts/security/verify-accounts.mjs",
    "verify:tools": "python3 scripts/security/toolchain/verify.py",
    "verify:campaign": "node --test tests/campaign-crypto.test.mjs tests/security-campaign-http.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.7",
    "wrangler": "4.157.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "fflate@0.7": "0.7.5"
  }
}
